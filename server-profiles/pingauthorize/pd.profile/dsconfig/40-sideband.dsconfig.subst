# 40-sideband.dsconfig.subst — sideband shared secret + endpoint for the
# load generator. Modeled on a working agentgateway integration's endpoint:
# the secret and header blocks are identical (the k6
# script sends PDG-TOKEN, as a gateway-side adapter does); the endpoint
# points at the local PerfSubjectJWT validator instead of the
# internet-hosted JWT-Lab.
#
# The endpoint boots directly in Ping's documented service-dispatch shape —
# the deployment's resting state, pairing with the x100-services snapshot
# the PAP hook imports at boot (100 ServiceDefinitions and service-targeted
# policy sets; the {mcp} capture derives the per-request service value).
# Flat batch, no conditionals: the .subst layer cannot branch (a shell `if`
# here aborts the expanded batch — live finding, 2026-11-24). resource-path
# MUST carry {mcp}: base-path otherwise consumes the whole URI,
# HttpRequest.ResourcePath resolves empty, and condition evaluation over it
# errors INDETERMINATE (fail-closed 403). The plain shape of the campaign
# of record (base-path:/mcp, service:AgentGateway) is reachable between runs
# via scripts/swap-policy.sh baseline.

# Order matters: the shared secret must exist before the Sideband API
# extension references it.
dsconfig create-sideband-api-shared-secret \
    --secret-name AGENTGATEWAY-SIDEBAND \
    --set "shared-secret:${SIDEBAND_SHARED_SECRET}"

# Header name must match what the load generator sends (PDG-TOKEN).
dsconfig set-http-servlet-extension-prop \
    --extension-name "Sideband API" \
    --set shared-secret-header-name:PDG-TOKEN \
    --add "shared-secrets:AGENTGATEWAY-SIDEBAND"

dsconfig create-sideband-api-endpoint \
    --endpoint-name "AgentGateway Portfolio MCP" \
    --set "base-path:/mcp/{mcp}" \
    --set "service:AgentGateway {mcp}" \
    --set "resource-path:{mcp}" \
    --set access-token-validator:PerfSubjectJWT
