# Profile: stage-1500 — extended level 1500 decisions/second.
# The 1000/s level was handled cleanly (~2% CPU, clean p95) while 2000/s
# overran the packed shared cluster (generator CPU starvation even after the
# 500m request fix), so this probes the midpoint. Same run shape (10 agents,
# 5m measured + 30s warmup, weighted mix, unchanged thresholds); concurrency
# interpolated between the two neighbours: 150/agent, VUs at 5%/12% of RATE.
#
# Usage: PROFILE=stage-1500 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
# MAX_VUS is 240, not the interpolated 180: in the 2026-11-16 run the 180
# cap shed 137 iterations across the 5 minutes (rare ~1s tail iterations
# stacking at 150 it/s per agent need headroom), which tripped the strict
# dropped-iterations gate and failed an otherwise clean run. 240 mirrors
# stage-2000's per-agent ceiling and removes the client-side cap as a
# variable when reading the tail.
RATE=1500
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=75
MAX_VUS=240
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's JWKS fetch) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
