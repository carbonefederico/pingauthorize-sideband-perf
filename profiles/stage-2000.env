# Profile: stage-2000 — extended level 2000 decisions/second.
# The 1000/s level stayed at ~2% CPU with clean p95, so this probes the next
# doubling. Same run shape (10 agents, 5m measured + 30s warmup, weighted mix,
# unchanged thresholds); concurrency scaled to the 200/s-per-agent arrival
# rate. 2000/10 = 200/agent exactly — no drift.
#
# Usage: PROFILE=stage-2000 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
# PRE_ALLOCATED_VUS=50 with MAX_VUS=300: the dropped-iterations gate on this
# level is decided at the warmup->measured transition, where k6 launches
# every measured scenario's pre-allocated VUs at once — a burst of
# PRE x 5 scenarios x 10 agents of fresh TLS connections. Evidence from the
# 2026-11-16 runs: 3,750 (the 1500/s level) was absorbed with zero slow
# iterations; 5,000 (PRE=100) stalled PAZ ~8s and shed 4-14 iterations per
# agent; 15,000 (PRE=300) collapsed the SUT outright (30s timeouts, ~40k
# dropped iterations per agent). 50 per scenario keeps the burst at 2,500,
# under the proven-clean bound; MAX=300 leaves stall headroom. Steady state
# needs ~2 VUs per scenario; the pool size above the burst only matters
# during a stall.
RATE=2000
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=50
MAX_VUS=300
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's JWKS fetch) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
