# Profile: scale-100 — policy-tree scaling campaign, 100-branch tree at the
# stage-1000 reference level (1000 decisions/second). Same run shape as the
# campaign levels (10 agents, 5m measured + 30s warmup) so the results stay
# comparable; thresholds unchanged. BRANCH_COUNT makes the load generator
# fan every request over the x100 snapshot's 100 MCP branches, drawn uniformly
# at random per request; the per-branch audience and URL suffixes are derived
# in the generator (branchAudience), not configured here.
#
# The same profile drives both x100 modes: BRANCH_COUNT only makes the
# generator fan requests over 100 branches — which tree is live (and which
# endpoint shape) is decided by ./scripts/swap-policy.sh before the run.
#
# Usage: PROFILE=scale-100 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
RATE=1000
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=50
MAX_VUS=120
INSECURE_SKIP_TLS_VERIFY=true

# --- Policy-tree scaling ----------------------------------------------
BRANCH_COUNT=100

# --- Subject tokens (self-signed by k6, validated by PAZ's trusted cert) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
